# woodyweb 根目录版本库忽略规则
#
# 本仓库以前没有根级 .gitignore，导致若干本地工具目录（合计约 9MB 的产物）
# 长期处于“未跟踪但未忽略”状态。只要在仓库根顺手执行 git add -A，
# 这些与源码无关的东西就会被扫进版本库，事后很难清理干净。这里一次性补上。
#
# 规则只覆盖「工具 / 缓存 / 本机环境」三类，不碰任何 PHP、Python 源码与文档。
# 注意：Git 的 .gitignore 不支持行尾注释，注释必须独占一行。

# 一、本机工具与会话产物（非源码，体积大，且随会话反复变动）
# .aksrc  —— akshare 源码包与打包缓存
# .archify —— 架构分析的一次性输出
# .dsh / .agents —— DSH 会话技能缓存与状态目录
# .workbuddy —— 助手工作台数据（含 .workbuddy/memory 工作日志，只留在本机）
/.aksrc/
/.archify/
/.dsh/
/.agents/
/.workbuddy/

# 二、Python 运行产物
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.tox/

# 三、本机环境与编辑器残留
.env
*.log
.DS_Store
Thumbs.db

# 四、本机数据库快照（改数据前的安全网，随机器而异，不该进版本库）
# _snapshots 目录下是 mysqldump 出来的整库副本，动辄几百 KB。
python/dbtools/_snapshots/

# 五、生产端页面缓存
# _prod_qdiipage_compare.py 抓生产端 qdiicn.php 时存的本机副本，用来在离线时
# 继续做对照。它是外部页面的快照：内容随生产端每天变，进版本库只会得到一份
# 过期且无人维护的副本。需要时重跑对照脚本即可重新抓取。
python/auto/_scratch/_qdiicn_prod.html
# _prod_category_check.py 抓 16 个分类页 + qdii 的缓存（HTML 与线上行序 JSON）。
# 同上：外部页面快照，需要时 `--fetch` 重抓；行序的含义见
# python/auto/README_category_pages_migration.md §6.2。
python/auto/_scratch/_prod_category_cache/

# 六、页面/截图快照与二进制抓取物
# _scratch 下的 .html（抓下来的页面）与 .png（截图）都是"某次会话的观测量"，
# 进版本库只会积压过期副本；脚本（.py/.php）与小体积 JSON 输入才是要留的。
python/auto/_scratch/*.html
python/auto/_scratch/*.png
# 改真库前的 mysqldump 备份（submit 族 smoke 用），随机器而异，几百 KB 起步。
python/auto/_scratch/_db_backup/

# 七、外部数据的二进制 fixture
# submit 族三页（分红 / 净值 / 历史）的对照 fixture 目录里，JSON 是真实样本的
# 全文（几百字节到十几 KB，进版本库便于离线复现解析差异）；xlsx / 老式 xls 是
# 二进制且在几十万字节量级。来源 URL 与重抓命令见
# python/auto/_scratch/_fixtures/README.md；单测不依赖这个目录（样本以常量形式
# 写在 auto/test_submitupdaters.py 里）。
python/auto/_scratch/_fixtures/*.xlsx
python/auto/_scratch/_fixtures/*.xls
