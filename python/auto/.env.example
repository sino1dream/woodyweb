# python/auto 数据库配置示例
#
# 用法：复制成 .env 再改成本机或生产库的真实值
#   Copy-Item python\auto\.env.example python\auto\.env
#
# 三条容易踩的规则：
#   1. 值不要加尖括号。校验会把 <...> 形式当成没填的占位值并拒绝启动，
#      例如 PALMMICRO_DB_USER=<root> 会被判为占位值，要写 PALMMICRO_DB_USER=root。
#   2. 不要加引号，也不要在行尾写注释（解析器按第一个 '=' 切分后只 strip 空白）。
#   3. .env 已被 .gitignore 忽略；生产环境推荐用环境变量注入密码，不要落盘。
#      同名 PALMMICRO_DB_* 环境变量优先于 .env 文件里的值。

# 数据库主机：本机 MariaDB/MySQL 用 127.0.0.1，原 PHP 生产环境用 mysql
PALMMICRO_DB_HOST=127.0.0.1

# 端口，默认 3306
PALMMICRO_DB_PORT=3306

# 登录用户名
PALMMICRO_DB_USER=root

# 库名：必须包含原 PHP 站点使用的表，至少要有
#   stock、stockhistory、calibration、calibrationhistory、
#   fundposition、fundpair、netvaluehistory、holdings、holdingsdate
PALMMICRO_DB_DATABASE=stock_data

# 登录密码：不能为空。留空会报 "PALMMICRO_DB_PASSWORD is required."，
# 请给该账号设置密码，或改用有密码的账号。
PALMMICRO_DB_PASSWORD=your-password
